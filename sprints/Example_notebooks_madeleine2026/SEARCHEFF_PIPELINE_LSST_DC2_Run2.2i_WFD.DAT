DOCUMENTATION:
  PURPOSE: LSST detection efficiency vs. SNR for DC2-SNIa
  REF:
  - AUTHOR: Sanchez, Kessler et al. 2021 (SNIa-cosmology with LSST-DC2)
    ADS:    https://ui.adsabs.harvard.edu/abs/2022ApJ...934...96S
  INTENT:     Nominal
  USAGE_KEY:  SEARCHEFF_PIPELINE_FILE
  USAGE_CODE: snlc_sim.exe
  VALIDATE_SCIENCE: used for DC2-SNIa cosmology analysis
  NOTES:
  - measure g,r,i,z EFF-vs-SNR curves from DC2 data
  - use g curve for u band (due to low u-band stats)
  - use z curve for Y band (due to low Y-band stats)
  - set EFF=1 for SNR>10
  - force EFF = 0 for SNR <=2 (RK, Oct 29 2021)
  VERSIONS:
  - DATE: 2021-03-05
    AUTHORS: B. Sanchez, R. Kessler
  - DATE: 2021-10-29
    AUTHORS: R.Kessler (force EFF=0 for low SNR)
DOCUMENTATION_END:


PHOTFLAG_DETECT:   4096  # set this PHOTFLAG bit for each detection
PHOTFLAG_TRIGGER:  2048  # flags epoch when trigger is formed

